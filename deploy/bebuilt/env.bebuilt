# Non-secret overrides written onto docker/.env by box-setup.sh (KEY=VALUE; each key replaces upstream's).
# Secrets never live here: they come from /etc/bebuilt/ragflow-secrets.env, pushed from the client's
# 1Password vault by scripts/ragflow-provision.sh in bebuilt-platform-v2.

# Nightly of 2026-09-17, built from 1ff3d9611 (this branch's base). v0.27.2 is affected by
# CVE-2026-93013; the fix (aa78e8d22, PR #19591) is an ancestor of the base. Pinned by digest, never a tag.
RAGFLOW_IMAGE=infiniflow/ragflow@sha256:f3a077c3c6668dbb0eee5488bf9f8c09b84509b15b2f03ea34354dbbbdf10536

DOC_ENGINE=opensearch
# tei-cpu serves a local embedding model, so embedding needs no provider key and no document text leaves
# the box. Whether a tenant uses it is chosen per dataset (D6), not here.
COMPOSE_PROFILES=opensearch,cpu,metadata-mysql,tei-cpu

# 16 GB box: OpenSearch capped at 4 GB with a 2 GB heap, leaving room for RAGFlow, MySQL and TEI.
MEM_LIMIT=4294967296
OPENSEARCH_JAVA_OPTS=-Xms2g -Xmx2g

TZ=UTC

# No self-service accounts. Users are created through the admin API from the box itself.
REGISTER_ENABLED=0
ENABLE_REGISTER=0
OAUTH_AUTO_REGISTER=false

# Local embeddings on a shared CPU: RAGFlow waits 30 s for each TEI call (hard-coded), and the default 16
# chunks per call plus five documents parsing at once pushed calls past it (2026-09-18, 8 of the first 50
# files). Four chunks per call and two documents at a time keep each call well inside the limit.
EMBEDDING_BATCH_SIZE=4
MAX_CONCURRENT_TASKS=2
